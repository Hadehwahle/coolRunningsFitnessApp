# Copy this file to .env and fill in the values. Never commit .env.

# ── Server ────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# Public URL of the frontend. Used in password-reset emails and sitemap.xml.
SITE_URL=http://localhost:3000

# ── Database ──────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/coolrunningsfitness

# ── Auth ──────────────────────────────────────────────────
# Use long random strings, e.g. run:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string
JWT_EXPIRE=15m          # access token (refreshed automatically in the background)
ADMIN_JWT_EXPIRE=10m
JWT_REFRESH_EXPIRE=7d   # how long "Remember me" keeps you signed in

# Frontend origin(s), comma-separated. Must match the browser URL exactly.
CORS_ORIGIN=http://localhost:3000

# Only needed in production when frontend and API are on DIFFERENT domains:
# leave unset (defaults to "none" in production, "lax" in development).
# COOKIE_SAMESITE=none

# ── Email (optional) ──────────────────────────────────────
# Leave SMTP_HOST/SMTP_USER blank in development: emails (e.g. password-reset
# links) are printed in the server console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@coolrunningsfitness.com
# Receives a copy of every contact-form message
ADMIN_EMAIL=

# ── Image uploads (optional) ──────────────────────────────
# Set this in production (Render/Railway delete local files on every deploy).
# Find it in your Cloudinary dashboard: cloudinary://<key>:<secret>@<cloud-name>
CLOUDINARY_URL=

# ── Rate limits (requests per 15 minutes, per IP) ─────────
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10
ADMIN_RATE_LIMIT_MAX=300
WRITE_RATE_LIMIT_MAX=60

# ── Security ──────────────────────────────────────────────
BCRYPT_ROUNDS=10
