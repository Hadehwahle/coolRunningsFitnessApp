# Only needed in production. In development, Vite proxies /api to localhost:5000.

# Full URL of the API, e.g. https://api.coolrunningsfitness.com/api
# Leave unset if the frontend and API are served from the same domain.
VITE_API_URL=

# Public URL of this site, used for canonical links and social previews
VITE_SITE_URL=https://coolrunningsfitness.com
